APP_ENV=development
HTTP_PORT=8080
DATABASE_URL=postgres://auth:auth@postgres:5432/auth_v2?sslmode=disable
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
JWT_ISSUER=https://auth.gdgbabcock.com
JWT_AUDIENCES=https://gdgbabcock.com,https://radar.gdgbabcock.com,https://orbit.gdgbabcock.com
JWT_HMAC_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
CERT_SERVICE_URL=http://host.docker.internal:8000
CERT_SERVICE_TOKEN=
