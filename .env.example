APP_ENV=development
HTTP_PORT=8080
DATABASE_URL=postgres://auth:local-only-auth-password@db:5432/legacy_auth?sslmode=disable
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
JWT_ISSUER=https://auth.gdgbabcock.com
JWT_AUDIENCES=https://gdgbabcock.com,https://radar.gdgbabcock.com,https://orbit.gdgbabcock.com
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
CERT_SERVICE_URL=http://host.docker.internal:8000
CERT_SERVICE_TOKEN=
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT=

# Swagger UI document host (no scheme) and base path
SWAGGER_HOST=localhost:8080
SWAGGER_BASE_PATH=/
